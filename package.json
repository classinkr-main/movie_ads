{
  "name": "movie-ads",
  "version": "1.0.0",
  "description": "Classin 영상 광고 모음 — 프로젝트/영상별 Remotion 컴포지션",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render",
    "render:p06": "remotion render p06-care-flow-40s out/06_20261006_수업전중후케어_40초_앱화면-학습흐름/수업전중후케어_40초_애니매틱_v1.mp4",
    "render:p07": "remotion render p07-one-standard-45s out/07_20261006_수업표준화_45초_앱화면-수업형태비교/수업표준화_45초_애니매틱_v1.mp4",
    "render:p09": "remotion render p09-classin-ai-features-30s out/09_20261007_ClassinAI_기능소개_30초_Remotion-모션그래픽/ClassinAI_기능소개_30초_v4.mp4",
    "still:p09": "remotion still p09-classin-ai-features-30s out/09_20261007_ClassinAI_기능소개_30초_Remotion-모션그래픽/still.png --frame=300",
    "typecheck": "tsc --noEmit",
    "mental:dev": "remotion studio projects/teachers-lost-their-minds/index.tsx --public-dir=projects/teachers-lost-their-minds/public",
    "mental:render": "node projects/teachers-lost-their-minds/scripts/render-segments.mjs",
    "mental:render:vertical": "node projects/teachers-lost-their-minds/scripts/render-segments.mjs --vertical",
    "mental:render:clean": "node projects/teachers-lost-their-minds/scripts/render-segments.mjs --clean",
    "mental:timeline": "node --experimental-strip-types --no-warnings projects/teachers-lost-their-minds/scripts/timeline.ts",
    "mental:sync": "node --experimental-strip-types --no-warnings projects/teachers-lost-their-minds/scripts/sync-from-srt.ts",
    "mental:snapshots": "bash projects/teachers-lost-their-minds/scripts/snapshots.sh",
    "mental:render:draft": "node projects/teachers-lost-their-minds/scripts/render-segments.mjs --draft",
    "render:gull": "remotion render GullReel out/classin-gull-showreel.mp4 --crf=21",
    "still:gull": "remotion still GullSheet out/gull-sheet.png --frame=40",
    "thumb:gull": "remotion still GullThumb out/classin-gull-thumbnail.png",
    "audio:gull": "node scripts/make-audio.mjs && ffmpeg -y -loglevel error -i public/audio/gull-reel.wav -c:a aac -b:a 192k public/audio/gull-reel.m4a",
    "render:reel": "remotion render BrandReel out/classin-brand-reel-60fps.mp4",
    "still:reel": "remotion still BrandReel out/reel-still.png --frame=780",
    "render:guangzhou": "remotion render GuangzhouVlog out/guangzhou-vlog-master.mp4 --crf=17 && bash scripts/guangzhou/encode_social.sh",
    "still:guangzhou": "remotion still GuangzhouVlog out/guangzhou-still.png --frame=180",
    "render:guangzhou-film": "remotion render GuangzhouEventFilm out/guangzhou-event-film-master.mp4 --crf=17 && bash scripts/guangzhou/encode_social.sh film",
    "shorts:cut": "python3 scripts/cut-clips.py",
    "shorts:render": "for id in short-01-ai-teacher short-02-institution short-03-learning short-04-teacher-pay short-05-first-year short-06-ai-kpi; do remotion render $id out/shorts/$id.mp4 --crf=20; done",
    "render:forum-live": "remotion render ForumLive out/forum-sketch-live-master.mp4 --crf=17",
    "render:forum-highlight": "remotion render ForumHighlight out/forum-sketch-highlight-master.mp4 --crf=17",
    "render:forum-speakers": "remotion render ForumSpeakers out/forum-sketch-speakers-master.mp4 --crf=17",
    "render:forum-sketch60": "remotion render ForumSketch60 out/forum-sketch-60s-master.mp4 --crf=17",
    "render:forum-style": "remotion render ForumStyle out/forum-sketch-style-master.mp4 --crf=17",
    "render:forum-short30": "remotion render ForumShort30 out/forum-sketch-30s-master.mp4 --crf=17",
    "render:forum-people": "remotion render ForumPeople out/forum-sketch-people-master.mp4 --crf=17",
    "render:forum-event": "remotion render ForumEvent out/forum-sketch-event-master.mp4 --crf=17",
    "render:forum-move": "remotion render ForumMove out/forum-sketch-move-master.mp4 --crf=17",
    "brag:audio": "python3 scripts/brag-audio.py",
    "brag:render": "remotion render Brag out/brag/brag-raw.mp4 && sh scripts/brag-poster.sh",
    "brag": "npm run brag:audio && npm run brag:render",
    "render:tm": "remotion render TeacherMgmt out/classin-ai-teacher-mgmt.mp4",
    "render:tmv": "remotion render TeacherMgmtValue out/classin-ai-teacher-mgmt-value.mp4",
    "still:tm": "remotion still TeacherMgmt out/still-tm.png --frame=400",
    "still:tmv": "remotion still TeacherMgmtValue out/still-tmv.png --frame=400",
    "render:hw": "remotion render Hardware out/classin-board-hardware.mp4",
    "still:hw": "remotion still Hardware out/hw-still.png --frame=300",
    "render:v5": "remotion render Showreel out/classin-showreel-v5.mp4",
    "render:v5-30": "remotion render Showreel30 out/classin-showreel-v5-30s.mp4",
    "social:v5": "node tools/social.mjs out/classin-showreel-v5.mp4",
    "social:v5-30": "node tools/social.mjs",
    "still:v5": "remotion still Showreel out/still.png --frame=262",
    "stills:v5": "node tools/stills.mjs --every 60",
    "music:v5": "python3 tools/music/fit_bgm.py",
    "music:v5-30": "python3 tools/music/fit_bgm.py --cues src/showreel-v5/data/cues-30s.json --out public/audio/classin-v5-30s.wav",
    "music:v5-synth": "python3 tools/music/compose.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/classinkr-main/movie_ads.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/classinkr-main/movie_ads/issues"
  },
  "homepage": "https://github.com/classinkr-main/movie_ads#readme",
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "^4.0.533",
    "@remotion/fonts": "^4.0.533",
    "@remotion/paths": "^4.0.533",
    "@remotion/three": "^4.0.533",
    "@remotion/transitions": "^4.0.533",
    "@types/three": "^0.187.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.533",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
