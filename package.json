{
  "name": "classin-ai-showreel",
  "version": "1.0.0",
  "description": "Classin 영상 광고 — 시네마틱 커머셜(20s) · AI 기능 쇼릴 v4(30s). Remotion 기반 모션그래픽",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Showreel out/classin-ai-showreel.mp4",
    "still": "remotion still Showreel out/still.png --frame=300",
    "typecheck": "tsc --noEmit",
    "render:cinematic": "remotion render Cinematic out/classin-cinematic-20s.mp4 --crf=20 --image-format=jpeg --jpeg-quality=96",
    "render:cinematic:silent": "remotion render Cinematic out/classin-cinematic-20s-silent.mp4 --crf=20 --image-format=jpeg --jpeg-quality=96 --muted",
    "score:cinematic": "node scripts/make-cinematic-score.mjs && ffmpeg -y -loglevel error -i public/audio/cinematic-score.wav -c:a aac -b:a 256k public/audio/cinematic-score.m4a",
    "stills:cinematic": "node scripts/cinematic-stills.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/classinkr-main/movie_ads.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/classinkr-main/movie_ads/issues"
  },
  "homepage": "https://github.com/classinkr-main/movie_ads#readme",
  "dependencies": {
    "@remotion/cli": "^4.0.533",
    "@remotion/fonts": "^4.0.533",
    "@remotion/noise": "4.0.533",
    "@remotion/transitions": "^4.0.533",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.533"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
