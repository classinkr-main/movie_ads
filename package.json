{
  "name": "classin-ai-showreel",
  "version": "1.0.0",
  "description": "Classin 커머셜 쇼릴 — Remotion 기반 (AI 키네틱 모션그래픽 30s · 갈매기 드로잉 애니메이션 49s)",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Showreel out/classin-ai-showreel.mp4",
    "still": "remotion still Showreel out/still.png --frame=300",
    "render:gull": "remotion render GullReel out/classin-gull-showreel.mp4",
    "still:gull": "remotion still GullSheet out/gull-sheet.png --frame=40",
    "audio": "node scripts/make-audio.mjs && ffmpeg -y -loglevel error -i public/audio/gull-reel.wav -c:a aac -b:a 192k public/audio/gull-reel.m4a",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/classinkr-main/movie_ads.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/classinkr-main/movie_ads/issues"
  },
  "homepage": "https://github.com/classinkr-main/movie_ads#readme",
  "dependencies": {
    "@remotion/cli": "^4.0.533",
    "@remotion/fonts": "^4.0.533",
    "@remotion/paths": "^4.0.533",
    "@remotion/transitions": "^4.0.533",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.533"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
