{
  "name": "classin-showreels",
  "version": "1.0.0",
  "description": "Classin 쇼릴 모음 — Remotion 기반 (AI 기능 쇼릴 v4, '멘탈이 나가 버렸습니다' 3D 스토리 쇼릴)",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Showreel out/classin-ai-showreel.mp4",
    "still": "remotion still Showreel out/still.png --frame=300",
    "typecheck": "tsc --noEmit",
    "mental:dev": "remotion studio projects/teachers-lost-their-minds/index.tsx --public-dir=projects/teachers-lost-their-minds/public",
    "mental:render": "node projects/teachers-lost-their-minds/scripts/render-segments.mjs",
    "mental:render:vertical": "node projects/teachers-lost-their-minds/scripts/render-segments.mjs --vertical",
    "mental:render:clean": "node projects/teachers-lost-their-minds/scripts/render-segments.mjs --clean",
    "mental:timeline": "node --experimental-strip-types --no-warnings projects/teachers-lost-their-minds/scripts/timeline.ts",
    "mental:sync": "node --experimental-strip-types --no-warnings projects/teachers-lost-their-minds/scripts/sync-from-srt.ts",
    "mental:snapshots": "bash projects/teachers-lost-their-minds/scripts/snapshots.sh",
    "mental:render:draft": "node projects/teachers-lost-their-minds/scripts/render-segments.mjs --draft"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/classinkr-main/movie_ads.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/classinkr-main/movie_ads/issues"
  },
  "homepage": "https://github.com/classinkr-main/movie_ads#readme",
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "^4.0.533",
    "@remotion/fonts": "^4.0.533",
    "@remotion/three": "^4.0.533",
    "@remotion/transitions": "^4.0.533",
    "@types/three": "^0.187.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.533",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
