node_modules
out/**/*.png
out/**/*.jpg
out/**/frames
.remotion
.DS_Store
out/**/preview-*
__pycache__

# vlog/ — 촬영 원본·작업 파일·결과물은 용량이 커서 커밋하지 않는다
vlog/*/raw
vlog/*/fonts
vlog/*/work
vlog/*/out
vlog/*/.venv

# OpenMontage 프로젝트 워크스페이스(projects/) — 소스·아티팩트·최종 렌더만 커밋
projects/*/assets/
projects/*/history/
projects/*/renders/segments/
projects/*/renders/*-draft.mp4
projects/*/renders/.remotion*
projects/*/renders/.final_review_frames/

# 갈매기 쇼릴 — 합성 중간 파일(wav)은 빼고 m4a만 커밋, 섬네일은 커밋
public/audio/gull-reel.wav
!out/classin-gull-thumbnail.png
!out/classin-gull-thumbnail-1280.jpg

# BrandReel — 가이드 효과음 합성 중간 파일
out/*.wav

# 광저우 투어 — 원본 소스·LUT 작업 폴더, 무손실 마스터 렌더
scripts/guangzhou/.src
scripts/guangzhou/luts
out/*-master.mp4

# 포럼 숏폼 — 원본에서 잘라 낸 클립과 렌더 결과는 용량이 커서 커밋하지 않는다(scripts/cut-clips.py로 재생성)
public/shorts/
out/shorts/

# 부산 포럼 스케치 — 원본에서 만든 중간본(클립·사진·오디오)과 미리보기
public/forum/clips
public/forum/audio
public/forum/stills
out/preview/
