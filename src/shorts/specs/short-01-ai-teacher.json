  "cues": [
    { "start": 1524.7, "end": 1530.15, "speaker": 1, "ko": "AI가 너무 발전하다 보니, 우리가 *AI의 부속품* 같은 선생님이 되지 않을까?" },
    { "start": 1554.8, "end": 1559.82, "speaker": 0, "src": "其实你说AI替代老师，我们自己也有疑虑。", "ko": "AI가 교사를 대체한다는 것, *저희도 걱정*합니다." },
    { "start": 1559.82, "end": 1563.62, "speaker": 0, "src": "但这件事，在程序员——就是我这个行业——", "ko": "그런데 이건 *프로그래머*, 바로 제 업계 이야기이기도 합니다." },
    { "start": 1563.62, "end": 1569.7, "speaker": 0, "src": "几乎所有的中国互联网公司、美国互联网公司，其实都在裁员。", "ko": "중국도 미국도, 거의 모든 인터넷 기업이 사실상 *감원* 중입니다." },
    { "start": 1570.1, "end": 1576.55, "speaker": 0, "src": "因为AI能够把很多基础的工作做了。", "ko": "AI가 *기초적인 업무*를 많이 해내니까요." },
    { "start": 1643.3, "end": 1647.15, "speaker": 0, "src": "越简单的工作，就越容易被替代。", "ko": "*단순한 일*일수록 더 쉽게 대체됩니다." },
    { "start": 1666.75, "end": 1672.22, "speaker": 0, "src": "我们要真的想一下，这件事能不能被AI替代。", "ko": "내가 하는 일이 AI로 대체될 수 있는지, 진지하게 따져 봐야 합니다." },
    { "start": 1672.22, "end": 1677.94, "speaker": 0, "src": "在我看来，天天讲的、年年讲的一样的课，", "ko": "제가 보기엔 매일, 매년 *똑같이 하는 강의*는" },
    { "start": 1677.94, "end": 1681.05, "speaker": 0, "src": "其实有可能属于简单重复的，会被替掉。", "ko": "단순 반복이라 대체될 수 있습니다." },
    { "start": 1702.6, "end": 1711.04, "speaker": 0, "src": "老师们要去为学生设计学习目标和评价方法。", "ko": "교사는 학생을 위해 *학습 목표와 평가 방법*을 설계해야 합니다." },
    { "start": 1712.02, "end": 1715.22, "speaker": 0, "src": "这个难度其实比讲一节课难多了，", "ko": "강의 한 번 하는 것보다 훨씬 어려운 일이죠." },
    { "start": 1715.22, "end": 1719.7, "speaker": 0, "src": "这就是要去做更难的、更高维度的工作，", "ko": "더 어렵고, 더 높은 차원의 일을 하는 겁니다." },
    { "start": 1719.7, "end": 1724.05, "speaker": 0, "src": "这反而更有效，更难被AI替代。", "ko": "그래서 오히려 *AI가 대체하기 어렵습니다*." }
  ]
}
