  "cues": [
    { "start": 515.4, "end": 521.32, "speaker": 0, "src": "很多韩国同行提到，一个优秀老师至少要三到五年的培养时间，", "ko": "한국 분들도, 좋은 강사 한 명 키우려면 최소 *3~5년*은 걸린다고 하셨죠." },
    { "start": 521.32, "end": 522.9, "speaker": 0, "src": "非常认同。", "ko": "정말 공감합니다." },
    { "start": 548.05, "end": 551.65, "speaker": 0, "src": "一年之内，要培养出一名成熟的教师。", "ko": "그래도 저희는 *1년 안에* 성숙한 강사를 키워 냅니다." },
    { "start": 908.55, "end": 913.95, "speaker": 0, "src": "教学授课的历练，对成长是最快的。", "ko": "실제로 수업해 보는 경험이 *가장 빨리* 키웁니다." },
    { "start": 913.95, "end": 918.72, "speaker": 0, "src": "我做了一个比较：在蓝天，一个老师自己带五个教学班，", "ko": "비교해 봤습니다. 스카이에듀 강사는 한 명이 *5개 반*을 맡고" },
    { "start": 918.72, "end": 923.58, "speaker": 0, "src": "每个班每次三个课时，全年五十七次课，", "ko": "반마다 한 번에 3교시, 1년에 57회 수업하니까" },
    { "start": 923.58, "end": 926.8, "speaker": 0, "src": "一年达到这样一个节数：855节。", "ko": "1년에 *855교시*가 됩니다." },
    { "start": 926.8, "end": 932.18, "speaker": 0, "src": "应届生毕业去公立学校的，我也去做了调查，", "ko": "졸업하고 공립학교로 간 교사도 조사해 봤는데" },
    { "start": 932.18, "end": 936.4, "speaker": 0, "src": "一般的初中老师，实际的全年节数是——", "ko": "일반 중학교 교사의 연간 수업은 *340교시*입니다." },
    { "start": 936.4, "end": 939.88, "speaker": 0, "src": "这样对比一下，从课程量来看，", "ko": "이렇게 수업량으로 비교해 보면" },
    { "start": 941.06, "end": 945.52, "speaker": 0, "src": "我觉得就能打造出一名合格、相对成熟的老师。", "ko": "충분히 *제 몫을 하는 강사*로 키울 수 있다고 봅니다." }
  ]
}
