  ],
  "cues": [
    { "start": 466.0, "end": 470.75, "speaker": 0, "src": "AI带来了海量的记忆能力，能记住很多。", "ko": "AI가 엄청난 *기억력*을 가져왔다고들 하죠." },
    { "start": 470.78, "end": 477.2, "speaker": 0, "src": "我用的是另一个词：AI能够持续理解我们的学习过程。", "ko": "저는 다르게 말하겠습니다. AI는 우리의 *학습 과정*을 계속 이해할 수 있습니다." },
    { "start": 479.2, "end": 486.18, "speaker": 0, "src": "以某一个学生来讲，学习过程就是他上过的课、", "ko": "학생 한 명을 놓고 보면, 그 학생이 들은 수업," },
    { "start": 486.18, "end": 491.25, "speaker": 0, "src": "他听到的东西、他输出的东西、作业、测验，", "ko": "들은 것, 말하고 쓴 것, 숙제와 시험까지." },
    { "start": 495.5, "end": 500.62, "speaker": 0, "src": "这所有的东西都可以被我们系统数字化地记录下来，", "ko": "이 모든 것이 시스템에 *디지털로 기록*됩니다." },
    { "start": 500.62, "end": 506.85, "speaker": 0, "src": "然后交给AI，去学习他的学习过程。", "ko": "그리고 AI가 그 학생의 학습 과정을 학습하죠." },
    { "start": 508.7, "end": 512.46, "speaker": 0, "src": "深度分析出这个学生学了什么、有什么问题，", "ko": "무엇을 배웠는지, 어떤 문제가 있는지," },
    { "start": 512.46, "end": 515.05, "speaker": 0, "src": "产生这个问题可能是什么原因。", "ko": "그 문제가 *왜* 생겼는지까지 깊이 분석합니다." },
    { "start": 538.15, "end": 545.6, "speaker": 0, "src": "合起来，我们就能够做到个性化——千人千面的教学。", "ko": "그래서 *천 명에게 천 가지*, 개인 맞춤 수업이 가능해집니다." }
  ]
}
