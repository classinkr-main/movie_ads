  "cues": [
    { "start": 982.05, "end": 987.7, "speaker": 0, "src": "过去因为没有数字化系统，没有AI沉淀能力，", "ko": "예전엔 디지털 시스템도, AI로 *쌓아 둘* 방법도 없었습니다." },
    { "start": 988.55, "end": 994.6, "speaker": 0, "src": "很多很多机构，这个课教得好不好，其实取决于一个个的老师。", "ko": "그래서 수업이 좋은지는 결국 *강사 한 명 한 명*에게 달려 있었죠." },
    { "start": 995.45, "end": 1000.18, "speaker": 0, "src": "但是如果系统、AI、数据沉淀这些都用起来，", "ko": "하지만 시스템과 AI, 데이터 축적을 제대로 쓰면" },
    { "start": 1000.18, "end": 1006.94, "speaker": 0, "src": "我们机构是可以沉淀出自己的AI课程设计、自己的AI评价，", "ko": "기관이 *자체 AI 커리큘럼*과 *자체 AI 평가*를 쌓을 수 있습니다." },
    { "start": 1006.94, "end": 1009.45, "speaker": 0, "src": "形成各个机构自己的核心竞争力。", "ko": "그게 기관마다의 *핵심 경쟁력*이 됩니다." },
    { "start": 1009.45, "end": 1015.0, "speaker": 0, "src": "教育是组织化的，不是靠一个老师干得好。", "ko": "교육은 조직의 일입니다. 선생님 한 명이 잘해서 되는 게 아니에요." },
    { "start": 1021.7, "end": 1026.0, "speaker": 0, "src": "老师要从简单的授课中摆脱出来。", "ko": "강사는 *단순한 강의*에서 벗어나야 합니다." }
  ]
