    {"id": "sb1", "at": 324, "lines": [[0.36, 2.34, "세상이 많이 변하는 만큼,"], [2.34, 5.48, "교육 또한 빠르게 준비해야 한다는 생각에"], [5.48, 7.3, "이 자리에 오게 되었습니다."]], "who": ["참가 원장님", "환영 만찬 인사"]},
    {"id": "sb2", "at": 720, "lines": [[0.0, 3.96, "이번 만남은 탁월교육과 한국 우수 교육기관의"], [3.96, 5.9, "또 한 번의 깊이 있는 교류입니다"]], "who": ["탁월교육 卓越教育", "환영 인사 · 중국어"]},
